# Copy to .env and fill in. Never commit .env.
# Allowed regions on this subscription: koreacentral, uaenorth, eastasia, centralindia, southindia.

# --- Azure AI Search (Free tier) ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<admin key>

# --- Microsoft Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4.1

# --- Microsoft Foundry Agent Service (the 7 agents are published here and run through Agent Service) ---
# Auth is Entra ID: `az login` locally, the container app's managed identity in Azure.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
AGENT_RUNTIME=foundry
# APPLICATIONINSIGHTS_CONNECTION_STRING=<optional; read from the project if omitted>
# TRACE_CONTENT=0   # 1 records prompts/answers in traces

# --- Per-role models (optional; each defaults to AZURE_OPENAI_CHAT_DEPLOYMENT, judge to ..._JUDGE_DEPLOYMENT) ---
# MODEL_<ROLE>=<deployment name>     roles: PLANNER SUBAGENT EXPANSION SQL WRITER JUDGE RERANK
# EFFORT_<ROLE>=none|minimal|low|medium|off   ("off" = omit reasoning_effort; needed for non-reasoning models)
# MODEL_PLANNER=gpt-5.4-nano
# EFFORT_PLANNER=low
# MODEL_EXPANSION=gpt-5.4-nano
# EFFORT_EXPANSION=minimal
# MODEL_JUDGE=gpt-5.4-mini
# EFFORT_JUDGE=low
# Optional cost read-out for models without a built-in price (USD per 1M tokens: input,output)
# PRICE_gpt-5.4-nano=0.00,0.00

# --- Azure AI Speech (optional; without it the UI uses the browser's built-in speech) ---
# AZURE_SPEECH_KEY=<key>
# AZURE_SPEECH_REGION=koreacentral
# AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural
# AZURE_SPEECH_LANGUAGE=en-US

# --- App limits ---
# APP_ACCESS_KEY=<shared code required by the UI; recommended for a public URL>
# RATE_LIMIT_PER_10MIN=40
# MAX_CONCURRENT_QUESTIONS=3
# ENABLE_UPLOADS=1
